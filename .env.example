# LLM Provider — set one key to use a real LLM; leave both blank for mock mode.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Force mock LLM responses (no API key needed when true).
MOCK_LLM=true

# ChromaDB — for local development without Docker, point to your local instance.
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Ticket Service Auth
APP_USERNAME=user
APP_PASSWORD=changeme-in-production

# Agent Core URL (used by ticket-service)
AGENT_CORE_URL=http://localhost:8000
